# Rappels push (#16) — variables d'environnement, SANS valeurs (dépôt public).
# Les vraies valeurs vivent UNIQUEMENT dans les variables d'environnement Vercel
# (ou dans un .env.local ignoré par git pour un essai local).
# Si l'une manque, les notifications push sont désactivées proprement
# (l'appli propose alors « Ajouter à mon agenda »).

# Clés VAPID (Web Push) : npx web-push generate-vapid-keys
# La clé publique est intégrée au code client au moment du build.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'expéditeur (https: ou mailto:)
VAPID_SUBJECT=

# Upstash QStash (intégration Vercel « Upstash QStash/Workflow » ou console Upstash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Facultatif : adresse de l'API QStash (fournie par l'intégration ; défaut https://qstash.upstash.io)
QSTASH_URL=

# Facultatif : origine publique de l'appli, destination des messages QStash.
# Sur Vercel, déduite de VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
APP_URL=
